# Azure DevOps Configuration
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_DEFAULT_PROJECT=YourProject
AZURE_DEVOPS_PAT=your-personal-access-token-here

# Security
MCP_API_KEY=your-api-key-here

# Server Configuration
PORT=3000
NODE_ENV=production

# How to generate PAT token:
# 1. Go to: https://dev.azure.com/{your-organization}/_usersSettings/tokens
# 2. Create new token with scopes: Code (Read), Build (Read & Execute), Work Items (Read, Write & Manage)

# How to generate API Key:
# openssl rand -base64 32
